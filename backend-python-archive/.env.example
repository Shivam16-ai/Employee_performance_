# Environment & Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="EPMS Enterprise Backend"
API_V1_PREFIX="/api/v1"

# Server Configuration
HOST=0.0.0.0
PORT=8001

# CORS Configuration (JSON array or comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://ais-dev-gsrdzjekintatdskhhhwlo-648052496423.asia-southeast1.run.app","https://ais-pre-gsrdzjekintatdskhhhwlo-648052496423.asia-southeast1.run.app"]

# PostgreSQL Database Configuration (SQLAlchemy 2.0 Async Engine)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=epms_user
POSTGRES_PASSWORD=epms_secure_password
POSTGRES_DB=epms_db

# Asynchronous connection URL (postgresql+asyncpg://...)
DATABASE_URL=postgresql+asyncpg://epms_user:epms_secure_password@localhost:5432/epms_db

# Synchronous connection URL (for Alembic migrations)
SYNC_DATABASE_URL=postgresql+psycopg2://epms_user:epms_secure_password@localhost:5432/epms_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Structured Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=text
