generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  COMPLETED
  CANCELLED
}

enum ProgressMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum MeasurementDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum ReviewCycleStatus {
  UPCOMING
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

// ==========================================
// 1. ORGANIZATION MANAGEMENT
// ==========================================

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(150)
  description String?    @db.Text
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz

  employees   Employee[]

  @@map("departments")
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  employeeCode     String           @unique @db.VarChar(50)
  firstName        String           @db.VarChar(100)
  lastName         String           @db.VarChar(100)
  email            String           @unique @db.VarChar(255)
  phone            String?          @db.VarChar(50)
  designation      String           @db.VarChar(150)
  departmentId     String           @db.Uuid
  managerId        String?          @db.Uuid
  dateOfJoining    DateTime         @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  // Relationships
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager              Employee?             @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  directReports        Employee[]            @relation("EmployeeManager")
  user                 User?
  goals                Goal[]
  reviewsReceived      Review[]              @relation("EmployeeReviews")
  reviewsGiven         Review[]              @relation("ReviewerReviews")
  performanceSnapshots PerformanceSnapshot[]

  @@index([departmentId])
  @@index([managerId])
  @@index([employmentStatus])
  @@map("employees")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  employeeId   String     @unique @db.Uuid
  passwordHash String     @db.VarChar(255)
  role         Role       @default(EMPLOYEE)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?  @db.Timestamptz
  createdAt    DateTime   @default(now()) @db.Timestamptz
  updatedAt    DateTime   @updatedAt @db.Timestamptz

  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  auditLogs    AuditLog[]

  @@map("users")
}

// ==========================================
// 2. GOAL MANAGEMENT
// ==========================================

model Goal {
  id                 String                @id @default(uuid()) @db.Uuid
  employeeId         String                @db.Uuid
  title              String                @db.VarChar(255)
  description        String?               @db.Text
  startDate          DateTime              @db.Date
  dueDate            DateTime              @db.Date
  status             GoalStatus            @default(NOT_STARTED)
  progressMode       ProgressMode          @default(HYBRID)
  manualProgress     Decimal               @default(0.00) @db.Decimal(5, 2)
  manualWeight       Decimal               @default(50.00) @db.Decimal(5, 2)
  kpiWeight          Decimal               @default(50.00) @db.Decimal(5, 2)
  calculatedProgress Decimal               @default(0.00) @db.Decimal(5, 2)
  createdBy          String?               @db.VarChar(100)
  createdAt          DateTime              @default(now()) @db.Timestamptz
  updatedAt          DateTime              @updatedAt @db.Timestamptz

  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  goalKpis           GoalKPI[]
  progressHistory    GoalProgressHistory[]

  @@index([employeeId])
  @@index([status])
  @@index([dueDate])
  @@map("goals")
}

// ==========================================
// 3. KPI MANAGEMENT
// ==========================================

model KPI {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String               @unique @db.VarChar(150)
  description          String?              @db.Text
  measurementUnit      String               @db.VarChar(50)
  measurementDirection MeasurementDirection @default(HIGHER_IS_BETTER)
  createdAt            DateTime             @default(now()) @db.Timestamptz
  updatedAt            DateTime             @updatedAt @db.Timestamptz

  goalKpis             GoalKPI[]

  @@map("kpis")
}

model GoalKPI {
  id          String      @id @default(uuid()) @db.Uuid
  goalId      String      @db.Uuid
  kpiId       String      @db.Uuid
  targetValue Decimal     @db.Decimal(12, 4)
  weight      Decimal     @db.Decimal(5, 2)
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  goal        Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  kpi         KPI         @relation(fields: [kpiId], references: [id], onDelete: Restrict)
  kpiRecords  KPIRecord[]

  @@unique([goalId, kpiId])
  @@index([goalId])
  @@index([kpiId])
  @@map("goal_kpis")
}

model KPIRecord {
  id          String   @id @default(uuid()) @db.Uuid
  goalKpiId   String   @db.Uuid
  actualValue Decimal  @db.Decimal(12, 4)
  recordedBy  String   @db.VarChar(100)
  recordedAt  DateTime @default(now()) @db.Timestamptz
  notes       String?  @db.Text

  goalKpi     GoalKPI  @relation(fields: [goalKpiId], references: [id], onDelete: Cascade)

  @@index([goalKpiId])
  @@index([recordedAt])
  @@map("kpi_records")
}

// ==========================================
// 4. QUARTERLY PERFORMANCE REVIEWS
// ==========================================

model ReviewCycle {
  id             String                @id @default(uuid()) @db.Uuid
  name           String                @unique @db.VarChar(100)
  startDate      DateTime              @db.Date
  endDate        DateTime              @db.Date
  reviewDeadline DateTime              @db.Date
  status         ReviewCycleStatus     @default(UPCOMING)
  createdAt      DateTime              @default(now()) @db.Timestamptz
  updatedAt      DateTime              @updatedAt @db.Timestamptz

  reviews        Review[]
  snapshots      PerformanceSnapshot[]

  @@map("review_cycles")
}

model Review {
  id               String         @id @default(uuid()) @db.Uuid
  employeeId       String         @db.Uuid
  reviewerId       String         @db.Uuid
  reviewCycleId    String         @db.Uuid
  overallScore     Decimal?       @db.Decimal(3, 2)
  status           ReviewStatus   @default(DRAFT)
  managerFeedback  String?        @db.Text
  employeeComments String?        @db.Text
  publishedAt      DateTime?      @db.Timestamptz
  acknowledgedAt   DateTime?      @db.Timestamptz
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @updatedAt @db.Timestamptz

  employee         Employee       @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer         Employee       @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewCycle      ReviewCycle    @relation(fields: [reviewCycleId], references: [id], onDelete: Restrict)
  ratings          ReviewRating[]

  @@unique([employeeId, reviewCycleId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([reviewCycleId])
  @@index([status])
  @@map("reviews")
}

model ReviewRating {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @db.Uuid
  category  String   @db.VarChar(100)
  rating    Decimal  @db.Decimal(3, 2)
  comments  String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, category])
  @@index([reviewId])
  @@map("review_ratings")
}

// ==========================================
// 5. PERFORMANCE HISTORY & ANALYTICS
// ==========================================

model GoalProgressHistory {
  id               String   @id @default(uuid()) @db.Uuid
  goalId           String   @db.Uuid
  previousProgress Decimal  @db.Decimal(5, 2)
  newProgress      Decimal  @db.Decimal(5, 2)
  changedBy        String   @db.VarChar(100)
  changeReason     String   @db.Text
  changedAt        DateTime @default(now()) @db.Timestamptz

  goal             Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([changedAt])
  @@map("goal_progress_history")
}

model PerformanceSnapshot {
  id                  String      @id @default(uuid()) @db.Uuid
  employeeId          String      @db.Uuid
  reviewCycleId       String      @db.Uuid
  overallScore        Decimal     @db.Decimal(3, 2)
  kpiAchievementScore Decimal     @db.Decimal(5, 2)
  managerRating       Decimal     @db.Decimal(3, 2)
  snapshotData        Json        @db.JsonB
  calculatedAt        DateTime    @default(now()) @db.Timestamptz

  employee            Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reviewCycle         ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, reviewCycleId])
  @@index([employeeId])
  @@index([reviewCycleId])
  @@map("performance_snapshots")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String   @db.VarChar(100)
  oldValues   Json?    @db.JsonB
  newValues   Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz

  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 6. SYSTEM BASELINE (From Phase 1)
// ==========================================

model SystemMigrationLog {
  id        String   @id @default(uuid())
  migration String
  appliedAt DateTime @default(now())

  @@map("_epms_system_migration_log")
}
