# Application Environment
NODE_ENV=development
PORT=8001
HOST=0.0.0.0
APP_NAME="EPMS Enterprise Backend (Node.js)"
API_V1_PREFIX="/api/v1"

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration via Prisma (epms_prisma_dev)
DATABASE_URL=postgresql://epms_user:epms_secure_password@localhost:5432/epms_prisma_dev?schema=public

# Logging Level (combined, dev, common)
LOG_LEVEL=dev
